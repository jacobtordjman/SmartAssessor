      "cell_type": "code",
      "source": [
        "# Simple GPU-only \"chat\" tester for WizardMath (no agents, no tools)\n",
        "\n",
        "# (Optional install if your runtime is fresh)\n",
        "# !pip -q install transformers accelerate torch\n",
        "\n",
        "import torch\n",
        "from transformers import AutoTokenizer, AutoModelForCausalLM, pipeline\n",
        "from transformers import logging as hf_logging\n",
        "hf_logging.set_verbosity_error()\n",
        "\n",
        "print(f\"CUDA available: {torch.cuda.is_available()}\")\n",
        "if torch.cuda.is_available():\n",
        "    print(\"GPU:\", torch.cuda.get_device_name(0))\n",
        "\n",
        "# ==== Load your merged WizardMath model on GPU (fp16) ====\n",
        "MERGED_MODEL_DIR = \"/content/drive/MyDrive/models/WizardMath-7B-V1.1-SmartAssessor-Merged\"\n",
        "\n",
        "tokenizer = AutoTokenizer.from_pretrained(MERGED_MODEL_DIR)\n",
        "model = AutoModelForCausalLM.from_pretrained(\n",
        "    MERGED_MODEL_DIR,\n",
        "    dtype=torch.float16,     # use dtype (newer transformers)\n",
        "    device_map=\"auto\"\n",
        ")\n",
        "model.eval()\n",
        "print(\"WizardMath loaded ✅\")\n",
        "\n",
        "# ==== Build a tiny chat-style wrapper ====\n",
        "gen = pipeline(\n",
        "    \"text-generation\",\n",
        "    model=model,\n",
        "    tokenizer=tokenizer,\n",
        "    max_new_tokens=256,      # keep answers short-ish\n",
        "    do_sample=False,         # deterministic for math\n",
        "    pad_token_id=tokenizer.eos_token_id,\n",
        "    eos_token_id=tokenizer.eos_token_id,\n",
        ")\n",
        "\n",
        "SYSTEM = (\n",
        "    \"You are WizardMath. Solve math problems step-by-step concisely.\\n\"\n",
        "    \"If the problem has a numeric result, end with: Final Answer: <number>\"\n",
        ")\n",
        "\n",
        "# Keep a tiny rolling history to feel like chat (doesn't balloon context)\n",
        "HISTORY_TURNS = 3\n",
        "history = []  # list of (user, assistant)\n",
        "\n",
        "def _render_prompt(user_msg: str) -> str:\n",
        "    lines = [SYSTEM, \"\"]\n",
        "    for u, a in history[-HISTORY_TURNS:]:\n",
        "        lines.append(f\"User: {u}\")\n",
        "        lines.append(f\"Assistant: {a}\")\n",
        "    lines.append(f\"User: {user_msg}\")\n",
        "    lines.append(\"Assistant:\")\n",
        "    return \"\\n\".join(lines)\n",
        "\n",
        "def ask(msg: str, keep_history: bool = True) -> str:\n",
        "    prompt = _render_prompt(msg)\n",
        "    out = gen(prompt, return_full_text=False)[0][\"generated_text\"].strip()\n",
        "    if keep_history:\n",
        "        history.append((msg, out))\n",
        "    return out\n",
        "\n",
        "def clear_history():\n",
        "    history.clear()\n",
        "\n",
        "# ==== Example test ====\n",
        "print(ask(\"Compute the determinant of the matrix [[8, 10], [-11, -5]]\"))\n",
        "\n",
        "# ==== Optional interactive loop (uncomment to use in Colab) ====\n",
        "# while True:\n",
        "#     q = input(\"Problem> \").strip()\n",
        "#     if q.lower() in {\"exit\", \"quit\"}:\n",
        "#         break\n",
        "#     print(ask(q))\n"
      ],
