        "\n",
        "# Regex-only parser (no LLM interference)\n",
        "def parse_answer_improved(text: str, debug: bool = True) -> Dict[str, Any]:\n",
        "    \"\"\"\n",
        "    Parse answer using only regex (no parser LLM)\n",
        "    \"\"\"\n",
        "    patterns = [\n",
        "        r\"Final\\s*Answer\\s*:\\s*([+-]?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:[eE][+-]?\\d+)?)\",\n",
        "        r\"The\\s*answer\\s*is\\s*([+-]?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:[eE][+-]?\\d+)?)\",\n",
        "        r\"Answer\\s*:\\s*([+-]?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:[eE][+-]?\\d+)?)\",\n",
        "        r\"=\\s*([+-]?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:[eE][+-]?\\d+)?)(?:\\s|$)\",\n",
        "    ]\n",
        "    \n",
        "    final_answer = None\n",
        "    matched_pattern = None\n",
        "    \n",
        "    for i, pattern in enumerate(patterns):\n",
        "        match = re.search(pattern, text, re.IGNORECASE)\n",
        "        if match:\n",
        "            try:\n",
        "                final_answer = float(match.group(1))\n",
        "                matched_pattern = f\"Pattern {i+1}\"\n",
        "                break\n",
        "            except (ValueError, TypeError):\n",
