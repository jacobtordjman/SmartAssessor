        "        \"parsing_success\": final_answer is not None\n",
        "    }\n",
        "\n",
        "# Manual verification functions\n",
        "def manual_determinant_2x2(matrix):\n",
        "    \"\"\"Calculate 2x2 determinant: ad - bc\"\"\"\n",
        "    return matrix[0][0] * matrix[1][1] - matrix[0][1] * matrix[1][0]\n",
        "\n",
        "def manual_determinant_3x3(matrix):\n",
        "    \"\"\"Calculate 3x3 determinant using cofactor expansion\"\"\"\n",
        "    a, b, c = matrix[0]\n",
        "    d, e, f = matrix[1] \n",
        "    g, h, i = matrix[2]\n",
        "    \n",
        "    return (a * (e * i - f * h) - \n",
        "            b * (d * i - f * g) + \n",
        "            c * (d * h - e * g))\n",
        "\n",
        "def extract_matrix_from_question(question: str):\n",
        "    \"\"\"Extract matrix from question text\"\"\"\n",
        "    import re\n",
        "    pattern = r'\\[\\[(.*?)\\]\\]'\n",
